{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(gh:*)",
      "Bash(git worktree:*)",
      "Bash(terragrunt plan:*)",
      "Bash(terragrunt validate:*)",
      "Bash(terragrunt hcl fmt:*)",
      "Bash(terragrunt output:*)",
      "Bash(terragrunt show:*)",
      "Bash(terragrunt run --all plan:*)",
      "Bash(terragrunt run --all validate:*)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/.ssh/**)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/id_ecdsa*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "statusLine": {
    "type": "command",
    "command": "/Users/manucalop/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true,
    "gitlab@anthropic-plugin-directory": true
  },
  "outputStyle": "Concise",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "agent": "lead",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "teammateMode": "tmux",
  "agentPushNotifEnabled": true
}
